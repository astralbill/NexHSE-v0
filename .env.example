# Shared shop/admin persistence. Provision PostgreSQL and set the real connection string in deployment secrets.
DATABASE_URL=

# Generate with: openssl rand -base64 36
# Set this only in local ignored .env and Vercel project environment variables.
ADMIN_API_KEY=

# Supabase Auth. SUPABASE_SERVICE_ROLE_KEY is server-only and must never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_MODE=hybrid

# Server-only Vercel Blob token for admin media uploads and catalog image seeding.
BLOB_READ_WRITE_TOKEN=

# Stripe Checkout. Configure the webhook endpoint at /api/payments/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Safaricom Daraja STK Push. Callback URL is the public endpoint without the token query parameter.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
